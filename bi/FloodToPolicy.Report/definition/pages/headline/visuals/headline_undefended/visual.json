    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "These are undefended figures",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#1B1F27",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The JRC hazard maps model no dykes, walls or retention: they show where a river flood would go, not where defences let it go today - page 2 takes the defences out.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B1F27",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The JRC's own headline, about 160,000 people a year, is defended and weighted by probability. It answers a different question; it does not contradict this one.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B1F27",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Expected annual exposure weights the nine return periods by their probability over the sampled band, 1-in-10 to 1-in-500. A lower bound, never an expected damage.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#1B1F27",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "EU-27 only: a page filter. Clear it in the Filters pane to see all 37 countries.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#5D6675",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
