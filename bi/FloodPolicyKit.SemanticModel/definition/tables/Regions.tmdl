	/// Country, then region: the path every drill-down in the report follows.
	hierarchy Geography
		lineageTag: 3f9ab530-d77d-506e-bd15-9bbd905dae1e

		level Country
			lineageTag: 4281bf5c-aef9-5ffa-ad0c-4bc0dc39a21f
			column: country_name

		level Region
			lineageTag: 7ff874fd-1b08-5b85-affa-35f9a9f90fac
			column: region

	partition Regions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "regions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
