          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Also behind the pages",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#1B1F27",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Liège: the floodplain is 47 % sealed, against 14 % for the arrondissement around it (page 5).",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#1B1F27",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "July 2021: the Ahr at Ahrweiler passed its 1-in-500-year discharge; 44 of its 55 river cells went past 1-in-100 in the EFAS reanalysis (page 5).",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#1B1F27",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Declared risk areas are not comparable: the median Belgian region declares 99.99 % of its area, the median Spanish one 0.004 %; Ireland and Lithuania report none (page 7).",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#1B1F27",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How to explore: Hover a bar or dot for the place's card; right-click a region > Drill through > Region detail. The arrows on a chart open a country into its regions.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#5D6675",
                      "fontWeight": "normal",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
