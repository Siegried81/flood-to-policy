// VS Code "Reopen in Container": a Linux shell on the project's `test` image
// (geospatial stack + pytest). Adds a separate `dev` service; `app` and `api` untouched.
{
	"name": "flood-to-policy (Linux, geospatial stack)",
	"dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
	"service": "dev",
	"runServices": ["dev"],
	"workspaceFolder": "/workspaces/flood-to-policy",
	"shutdownAction": "stopCompose",
	"features": {
		// The image is python:3.12-slim, which has no git; VS Code's Source Control needs it.
		"ghcr.io/devcontainers/features/git:1": {}
	},
	// Streamlit and the API, when started from the container's terminal.
	"forwardPorts": [8501, 8001],
	"customizations": {
		"vscode": {
			"extensions": ["ms-python.python", "ms-python.debugpy"],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.testing.pytestEnabled": true
			}
		}
	}
}
